{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taghazout-garden-house",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-30",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "taghazout-garden-house", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID" }],
  "vars": { "PUBLIC_SITE_URL": "https://REPLACE_WITH_YOUR_DOMAIN" }
}
